# 正式环境必须设置强随机值，并通过部署平台的 Secret 管理，不要提交真实值。
AIGEO_HOST=0.0.0.0
AIGEO_PORT=8765
AIGEO_DATA_DIR=/data
AIGEO_ADMIN_USER=admin
AIGEO_ADMIN_PASSWORD=replace-with-a-long-random-password
AIGEO_SESSION_SECRET=replace-with-at-least-32-random-bytes
AIGEO_COOKIE_SECURE=1
AIGEO_SESSION_TTL=43200

# 可选：OpenAI Responses API 或兼容服务。只保存在服务端。
AIGEO_AI_API_KEY=
AIGEO_AI_BASE_URL=https://api.openai.com/v1
AIGEO_AI_MODEL=gpt-5-mini
